# Copy this file to .env and adjust. Never commit .env.

# PostgreSQL connection string.
# The value below matches the bundled dev database started by `npm run db:dev`.
# For your own PostgreSQL use: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/buynest

# Port the API listens on.
PORT=4000

# development | test | production
NODE_ENV=development

# Comma-separated browser origins allowed to call the API (web storefront / admin).
# Leave empty in development to allow any origin. Native mobile apps are not affected by CORS.
CORS_ORIGINS=
