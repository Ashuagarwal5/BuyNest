// BuyNest database schema.
// All money is integer paise (₹149.50 = 14950). Never add a float money column.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  DELIVERY_FAILED
}

enum PaymentMethod {
  COD
}

// Independent of OrderStatus: a delivered order is not automatically a paid one.
enum PaymentStatus {
  PENDING
  COLLECTED
  REFUNDED
}

enum InventoryTransactionType {
  RESERVE
  RELEASE
  SALE
  ADJUSTMENT
}

model Category {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  imageUrl     String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]

  @@index([isActive, displayOrder])
}

model Product {
  id                String  @id @default(cuid())
  name              String
  slug              String  @unique
  description       String
  categoryId        String
  sku               String  @unique
  mrpPaise          Int
  sellingPricePaise Int
  // Physical units on hand. Only reduced when an order is delivered (SALE).
  stockQuantity     Int     @default(0)
  // Units held by placed-but-undelivered orders. Available = stockQuantity - reservedQuantity.
  // The migration adds CHECK constraints keeping 0 <= reservedQuantity <= stockQuantity.
  reservedQuantity  Int     @default(0)
  lowStockThreshold Int     @default(5)
  isActive          Boolean @default(true)
  isFeatured        Boolean @default(false)
  isNew             Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                ProductImage[]
  orderItems            OrderItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([isActive, isNew])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  url          String
  altText      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
}

// Guest-checkout customer, identified by normalized 10-digit Indian mobile number.
model Customer {
  id        String   @id @default(cuid())
  fullName  String
  mobile    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model DeliveryArea {
  id                         String   @id @default(cuid())
  name                       String   @unique
  pincode                    String?
  deliveryChargePaise        Int
  minimumOrderPaise          Int?
  freeDeliveryThresholdPaise Int?
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  orders Order[]
}

model Order {
  id              String @id @default(cuid())
  orderNumber     String @unique
  // Supplied by the client; a retry with the same value returns this order instead of creating another.
  clientRequestId String @unique
  // Opaque secret returned once to the customer; required to read or cancel the order.
  trackingToken   String
  customerId      String

  // Snapshots taken at order time. Never re-read these from Customer / DeliveryArea.
  customerName  String
  customerPhone String
  addressLine1  String
  addressLine2  String?
  area          String
  landmark      String?
  city          String
  pincode       String

  deliveryAreaId String

  subtotalPaise       Int
  deliveryChargePaise Int
  discountPaise       Int @default(0)
  grandTotalPaise     Int

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(PLACED)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  deliveryArea          DeliveryArea           @relation(fields: [deliveryAreaId], references: [id], onDelete: Restrict)
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  inventoryTransactions InventoryTransaction[]

  @@index([customerId])
  @@index([orderStatus, createdAt])
}

// Historical snapshot: name, SKU, image and price as they were when the order was placed.
model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  productName  String
  sku          String
  productImage String?

  unitPricePaise Int
  quantity       Int
  lineTotalPaise Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// Audit trail of every stock movement. `quantity` is always positive; `type` gives the direction.
model InventoryTransaction {
  id        String                   @id @default(cuid())
  productId String
  orderId   String?
  type      InventoryTransactionType
  quantity  Int
  note      String?
  createdAt DateTime                 @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
}

// One row per calendar day (IST); incremented atomically to issue order numbers.
model OrderCounter {
  day          String @id
  lastSequence Int
}
