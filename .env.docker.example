# Optional overrides: copy to .env in the repository root for Docker Compose.
# Use a URL-safe password (letters, digits, hyphens, underscores).
POSTGRES_PASSWORD=buynest-local
BACKEND_NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
TRUST_PROXY_HOPS=0
ADMIN_SESSION_TTL_HOURS=12

# Master key for saved secrets (email password, Firebase key) and sign-in code hashes.
# Generate with `npm run secrets:key` in the Backend folder and paste the value here.
# Keep a private copy: without the same key, saved secrets must be entered again.
SECRETS_KEY=
