# Copy this file to .env.local and adjust. .env.local is ignored by Git.
# Restart `npm start` after changing it: Expo reads these values only at startup.

# Where the BuyNest backend is running (no trailing slash, no /api/v1).
#
# Web browser on this computer:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
#
# Physical phone (Expo Go): use this computer's LAN IP address, NOT localhost.
# On a phone, "localhost" is the phone itself. Find the IP with `ipconfig` (IPv4 Address).
# The phone and the computer must be on the same Wi-Fi network.
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:4000
#
# Android emulator: the emulator reaches this computer at 10.0.2.2.
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.39:4000


# Web / local development
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Physical device example:
# EXPO_PUBLIC_API_BASE_URL=http://YOUR_PC_LAN_IP:4000

# Android emulator example:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000